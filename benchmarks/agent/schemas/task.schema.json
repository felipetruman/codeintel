{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeIntel Agent Benchmark Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "query",
    "prompt",
    "corpus",
    "expected"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "locate-symbol",
        "relevant-files",
        "impact-analysis",
        "change-planning"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "corpus": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "direct_callers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "impacted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blast_radius": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
